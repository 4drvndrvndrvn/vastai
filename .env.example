# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# From https://cloud.vast.ai/manage-keys/
VAST_API_KEY=

# Optional: a Roblox account Studio signs in with by itself (the TuxBlox fork's
# --magictoken). It ends up on the rented machine, so use a throwaway account.
ROBLOX_USERNAME=
ROBLOX_PASSWORD=

# Optional: which TuxBlox release gets installed.
# TUXBLOX_REPO=4drvndrvndrvn/tuxblox
# TUXBLOX_RELEASE=latest
